APP_NAME=CLICD Billing
APP_PORT=8080
PUBLIC_URL=http://localhost:8080
# 填写域名后 deploy.sh 自动启用 Caddy HTTPS；同时把 PUBLIC_URL 改为 https://该域名。
DOMAIN=
TZ=Asia/Shanghai

POSTGRES_DB=clicd_billing
POSTGRES_USER=clicd
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
SESSION_SECRET=CHANGE_ME_SESSION
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK
# 留空时客户中心不会显示在线支付按钮。配置后需由支付适配器实现 docs/PAYMENT-CHECKOUT.md 协议。
PAYMENT_CHECKOUT_URL=
PAYMENT_PROVIDER_NAME=generic
# 可选：接收订单、工单和服务生命周期事件的通知适配器。
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=CHANGE_ME_NOTIFICATION
METRICS_TOKEN=CHANGE_ME_METRICS
WORKER_POLL_INTERVAL=3s
RECONCILE_INTERVAL=5m
LIFECYCLE_INTERVAL=1m
RENEWAL_LEAD_TIME=168h
OVERDUE_GRACE_PERIOD=72h
TERMINATION_RETENTION=168h
