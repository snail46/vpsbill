# 预构建镜像部署使用；latest 自动跟随 main，也可固定为 sha-<完整提交哈希>。
IMAGE_TAG=latest

# 访问方式（deploy.sh 按它发布端口、启用对应组件）：
#   direct      直接用 服务器IP:端口 访问，不配域名
#   caddy       Caddy 自动申请 HTTPS 证书，需要公网 IP，且域名已解析到本机
#   cloudflare  Cloudflare Tunnel，无需公网 IP；在 Cloudflare 后台把前台域名指向
#               http://web:7080、后台域名指向 http://web:7081
#   proxy       自己的 Nginx/宝塔/1Panel 等反向代理：前台转发到 127.0.0.1:PORTAL_PORT，
#               后台转发到 127.0.0.1:ADMIN_PORT，并传 X-Forwarded-For / X-Forwarded-Proto
ACCESS_MODE=direct
# 客户前台和管理后台的端口（caddy / cloudflare / proxy 模式下只监听 127.0.0.1）。
PORTAL_PORT=8080
ADMIN_PORT=8081
# caddy 模式：前台域名和后台域名，都要解析到本机。
DOMAIN=
ADMIN_DOMAIN=
# cloudflare 模式：Cloudflare Zero Trust → Networks → Tunnels 创建隧道后得到的令牌。
CLOUDFLARE_TUNNEL_TOKEN=

POSTGRES_DB=vpsbill
POSTGRES_USER=vpsbill
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
SESSION_SECRET=CHANGE_ME_SESSION
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION

# 多个 API 实例共享 Hatch Agent 时设置为 auto（或各实例可互访的内部地址）；单实例留空。
INTERNAL_URL=
