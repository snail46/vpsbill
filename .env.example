# 预构建镜像部署使用；latest 自动跟随 main，也可固定为 sha-<完整提交哈希>。
IMAGE_TAG=latest
# 使用域名 HTTPS 时必须改为 127.0.0.1:8080，防止绕过 Caddy 直接访问 Web 容器。
APP_PORT=8080
# 填写域名后 deploy.sh 自动启用 Caddy HTTPS。
DOMAIN=

POSTGRES_DB=clicd_billing
POSTGRES_USER=clicd
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
SESSION_SECRET=CHANGE_ME_SESSION
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION
